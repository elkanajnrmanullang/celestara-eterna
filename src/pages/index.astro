<script>
  const canvas = document.getElementById('star-canvas') as HTMLCanvasElement;
  if (canvas) {
    const ctx = canvas.getContext('2d');
    let particles: Star[] = [];
    let raf: number;

    function resize() {
      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;
    }
    resize();
    window.addEventListener('resize', () => { resize(); spawn(); });

    class Star {
      x!: number;
      y!: number;
      r!: number;
      op!: number;
      vx!: number;
      vy!: number;
      ph!: number;
      ps!: number;
      col!: string;

      constructor() { this.init(); }
      init() {
        this.x  = Math.random() * canvas.width;
        this.y  = Math.random() * canvas.height;
        this.r  = Math.random() * 1.4 + 0.2;
        this.op = Math.random() * 0.65 + 0.1;
        this.vx = (Math.random() - 0.5) * 0.18;
        this.vy = (Math.random() - 0.5) * 0.14 - 0.07;
        this.ph = Math.random() * Math.PI * 2;
        this.ps = Math.random() * 0.018 + 0.004;
        const t = Math.random();
        this.col = t < 0.14 ? '#D4AF37' : t < 0.28 ? '#EADBC8' : '#F8FAFC';
      }
      update() {
        this.x  += this.vx;
        this.y  += this.vy;
        this.ph += this.ps;
        if (this.x < 0 || this.x > canvas.width || this.y < -8) { this.init(); this.y = canvas.height + 4; }
      }
      draw() {
        if (!ctx) return;
        const o = this.op * (0.65 + 0.35 * Math.sin(this.ph));
        const hex = Math.floor(o * 255).toString(16).padStart(2,'0');
        ctx.beginPath();
        ctx.arc(this.x, this.y, this.r, 0, Math.PI * 2);
        ctx.fillStyle = this.col + hex;
        ctx.fill();
      }
    }

    function spawn() {
      const n = Math.min(Math.floor(canvas.width * canvas.height / 7500), 130);
      particles = Array.from({ length: n }, () => new Star());
    }

    function drawLines() {
      if (!ctx) return;
      const D = 95;
      for (let i = 0; i < particles.length; i++) {
        for (let j = i + 1; j < particles.length; j++) {
          const dx = particles[i].x - particles[j].x;
          const dy = particles[i].y - particles[j].y;
          const d  = Math.sqrt(dx*dx + dy*dy);
          if (d < D) {
            ctx.beginPath();
            ctx.moveTo(particles[i].x, particles[i].y);
            ctx.lineTo(particles[j].x, particles[j].y);
            ctx.strokeStyle = `rgba(212,175,55,${(1 - d/D) * 0.1})`;
            ctx.lineWidth   = 0.5;
            ctx.stroke();
          }
        }
      }
    }

    function loop() {
      if (!ctx) return;
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      drawLines();
      particles.forEach(p => { p.update(); p.draw(); });
      raf = requestAnimationFrame(loop);
    }

    spawn();
    loop();

    document.addEventListener('visibilitychange', () => {
      document.hidden ? cancelAnimationFrame(raf) : loop();
    });

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      cancelAnimationFrame(raf);
      ctx?.clearRect(0, 0, canvas.width, canvas.height);
    }
  }

  function runCounters() {
    document.querySelectorAll('[data-count]').forEach(el => {
      const targetElement = el as HTMLElement;
      const target = +(targetElement.dataset.count || 0);
      const sfx    = targetElement.dataset.sfx || '';
      let cur = 0;
      const step = target / 42;
      const t = setInterval(() => {
        cur += step;
        if (cur >= target) { 
          targetElement.textContent = target + sfx; 
          clearInterval(t); 
        } else { 
          targetElement.textContent = Math.floor(cur) + sfx; 
        }
      }, 38);
    });
  }

  const statsEl = document.querySelector('.hero-stats');
  if (statsEl) {
    new IntersectionObserver((entries) => {
      if (entries[0].isIntersecting) { runCounters(); }
    }, { threshold: 0.5 }).observe(statsEl);
  }

  document.querySelectorAll('a[href^="#"]').forEach(a => {
    a.addEventListener('click', function(e) {
      const target = e.currentTarget as HTMLAnchorElement;
      const h = target.getAttribute('href');
      if (!h || h === '#') return;
      e.preventDefault();
      const el = document.querySelector(h);
      if (el) {
        window.scrollTo({ top: el.getBoundingClientRect().top + window.scrollY - 78, behavior: 'smooth' });
      }
    });
  });
</script>