---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404: Node Terminated | Celestara Eterna">
  <main class="flex-grow max-w-7xl mx-auto px-8 py-24 w-full flex flex-col items-center justify-center text-center">
    <div class="border border-ce-bronze/30 bg-ce-cream p-12 max-w-lg w-full relative mx-auto">
      <div class="absolute top-0 left-0 border-b border-r border-ce-bronze/30 px-3 py-1 bg-ce-paper rounded-br-sm">
        <span class="font-mono text-ce-bronze text-[10px] tracking-widest uppercase">ERR-404</span>
      </div>
      <h1 class="font-fraunces text-6xl text-ce-navy mb-4 mt-6">404</h1>
      <p class="font-mono text-sm text-ce-bronze tracking-widest uppercase mb-6">Halaman tidak tersedia</p>
      <p class="text-ce-ink/80 mb-8 leading-relaxed">URL yang anda cari tidak tersedia.</p>
      <a href="/" class="border border-ce-navy bg-ce-navy text-ce-paper px-6 py-3 font-mono text-xs uppercase tracking-widest hover:bg-ce-gold hover:border-ce-gold transition-colors duration-200 inline-block">
        Kembali ke Beranda
      </a>
    </div>
  </main>
</Layout>