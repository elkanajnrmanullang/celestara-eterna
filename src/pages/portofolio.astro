---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const portofolioEntries = await getCollection('portofolio');
const sortedProjects = portofolioEntries.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const experiences = [
  {
    id: "EXP-01",
    role: "Fullstack & Backend Development",
    company: "Winnicode Garuda Teknologi",
    description: "Merancang dan mengimplementasikan pendekatan microservices yang menjembatani interaksi data antara halaman utama dan panel administrasi."
  }
];
---

<Layout title="Celestara Eterna | Portofolio">
  <main class="flex-grow max-w-7xl mx-auto px-8 py-12 w-full">
    <div class="mb-12">
      <h1 class="font-fraunces text-3xl md:text-4xl text-ce-navy mb-4">Rekam Jejak Eksekusi</h1>
      <p class="text-ce-ink/80 max-w-2xl text-lg">Dokumentasi portofolio rekayasa perangkat lunak dan spesialisasi sistem yang dikembangkan dengan fokus pada performa backend dan arsitektur fullstack.</p>
    </div>

    <section class="mb-16">
      <div class="border-b border-ce-bronze/30 pb-2 mb-6">
        <h2 class="font-mono text-sm text-ce-bronze tracking-widest uppercase">/ Proyek Sistem</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {sortedProjects.map((project) => (
          <a href={`/portofolio/${project.id}`} class="border border-ce-bronze/30 bg-ce-cream p-6 relative group hover:border-ce-navy transition-colors duration-300 flex flex-col block outline-none">
            <span class="font-mono text-ce-bronze text-[10px] tracking-widest uppercase mb-4 block">{project.data.id}</span>
            <h3 class="font-fraunces text-xl text-ce-navy mb-3 group-hover:text-ce-gold transition-colors">{project.data.title}</h3>
            <p class="text-ce-ink/80 text-sm leading-relaxed mb-6 min-h-[5rem]">{project.data.description}</p>
            <div class="flex flex-wrap gap-2 mt-auto">
              {project.data.tech.map((t) => (
                <span class="border border-ce-bronze/20 bg-ce-paper px-2 py-1 text-[10px] font-mono text-ce-ink uppercase">{t}</span>
              ))}
            </div>
          </a>
        ))}
      </div>
    </section>

    <section>
      <div class="border-b border-ce-bronze/30 pb-2 mb-6">
        <h2 class="font-mono text-sm text-ce-bronze tracking-widest uppercase">/ Rekam Profesional</h2>
      </div>
      <div class="flex flex-col gap-4">
        {experiences.map((exp) => (
          <div class="border border-ce-bronze/30 bg-ce-paper p-6 flex flex-col md:flex-row md:items-center justify-between gap-4">
            <div class="flex-1">
              <span class="font-mono text-ce-bronze text-[10px] tracking-widest uppercase block mb-1">{exp.id}</span>
              <h3 class="font-fraunces text-lg text-ce-navy">{exp.role}</h3>
              <span class="font-mono text-xs text-ce-ink/70 uppercase tracking-widest">{exp.company}</span>
            </div>
            <div class="flex-1 md:text-right">
              <p class="text-ce-ink/80 text-sm leading-relaxed">{exp.description}</p>
            </div>
          </div>
        ))}
      </div>
    </section>
  </main>
</Layout>